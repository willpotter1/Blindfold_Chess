VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Frontend dev server runs on http://localhost:8080.
# Local OTP requests are proxied through Vite, so this is optional for local development.
# Set VITE_OTP_API_BASE_URL only when you need a non-local OTP API in dev or an explicit production endpoint.
# VITE_OTP_API_BASE_URL=http://localhost:8787

# OTP API server (runs separately on http://localhost:8787)
OTP_SERVER_PORT=8787
OTP_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173,https://your-site.example
MAILERSEND_API_TOKEN=your_mailersend_api_token
MAILERSEND_FROM_EMAIL=auth@yourdomain.com
MAILERSEND_FROM_NAME=Blindchess
OTP_CODE_TTL_SECONDS=600
OTP_SEND_COOLDOWN_SECONDS=60
OTP_MAX_VERIFY_ATTEMPTS=5
OTP_HASH_SECRET=replace_with_a_long_random_secret

# Supabase admin credentials for server-side signup and password reset.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
