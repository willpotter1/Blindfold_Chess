VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_storage_bucket
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id
VITE_OTP_API_BASE_URL=http://localhost:8787

# OTP API server (MailerSend)
OTP_SERVER_PORT=8787
OTP_ALLOWED_ORIGIN=http://localhost:5173
MAILERSEND_API_TOKEN=your_mailersend_api_token
MAILERSEND_FROM_EMAIL=auth@yourdomain.com
MAILERSEND_FROM_NAME=Blindchess
OTP_CODE_TTL_SECONDS=600
OTP_SEND_COOLDOWN_SECONDS=60
OTP_MAX_VERIFY_ATTEMPTS=5
OTP_HASH_SECRET=replace_with_a_long_random_secret
